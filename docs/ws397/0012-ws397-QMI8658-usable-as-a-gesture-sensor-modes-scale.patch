   switch (BoardConfig::ACTIVE.sensors.imuType) {
     case BoardConfig::ImuType::Lsm6ds3:
       return writeReg(addr, REG_CTRL1_XL, CTRL1_XL_104HZ_2G) && writeReg(addr, REG_CTRL2_G, CTRL2_G_104HZ_245DPS);
