From c37d8ddaadce24990ad1d8b579e8517e2fa88765 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 8 Sep 2026 02:16:22 +0000
Subject: [PATCH 8/8] ws397: ES8311 volume in decibels, not a linear map onto
 the register

Register 0x32 of the ES8311 is logarithmic (dB = -95.5 + 0.5 * N), but
setVolume() scaled the percentage straight onto N. That put 70 % at about
-23 dB and 85 % at -7.5 dB, which is why the speaker on the ws397 sounded so
quiet at any setting below full.

Map the percentage onto decibels instead: 1 % = -40 dB, 100 % = +8 dB (0xCF,
the vendor maximum) and 0 = mute. 70 % now lands exactly on 0xB2, the value the
vendor firmware itself uses as the default for this 1 W speaker.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016HQ6nZag75VgtH5Z2WUGoF
---
 libs/hardware/AudioManager/src/AudioManager.cpp | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/libs/hardware/AudioManager/src/AudioManager.cpp b/libs/hardware/AudioManager/src/AudioManager.cpp
index 2a56e4c..c478743 100644
--- a/libs/hardware/AudioManager/src/AudioManager.cpp
+++ b/libs/hardware/AudioManager/src/AudioManager.cpp
@@ -179,9 +179,13 @@ void AudioManager::setVolume(uint8_t percent) {
   const auto& cfg = BoardConfig::ACTIVE.audio;
   if (cfg.codecAddr == 0) return;
   if (cfg.output == BoardConfig::AudioOutput::I2sEs8311) {
-    // Single DAC volume register, 0.5 dB/step; full scale matches the init
-    // value M5 ships for this speaker (+16 dB).
-    codecWrite(0x32, (uint8_t)((uint16_t)percent * ES8311_VOL_MAX_REG / 100));
+    // Register 0x32 is logarithmic: dB = -95.5 + 0.5 * N. Scaling the percentage
+    // linearly onto N put 70 % at about -23 dB and 85 % at -7.5 dB, which is why
+    // the speaker sounded so quiet. Map the percentage onto decibels instead:
+    // 1 % = -40 dB, 100 % = +8 dB (0xCF, the vendor maximum), and 70 % lands
+    // exactly on 0xB2, the vendor's own default for this 1 W speaker. 0 = mute.
+    const uint8_t reg = percent == 0 ? 0 : (uint8_t)(111 + ((uint16_t)percent * 96) / 100);
+    codecWrite(0x32, reg);
     return;
   }
   const uint8_t reg = (uint8_t)((uint16_t)percent * ES8388_VOL_MAX_REG / 100);
