@@ -255,23 +330,33 @@ bool AudioManager::ensureI2s(uint32_t sampleRate) {
   std.gpio_cfg.bclk = (gpio_num_t)cfg.bclk;
   std.gpio_cfg.ws = (gpio_num_t)cfg.lrclk;
